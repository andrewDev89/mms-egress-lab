      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(\n  vector(0)\n  and\n  (\n    sum(mms_queue_depth{carrier=\"unassigned\",status=~\"queued|sending|retry\"}) <= 0\n  )\n)\nor\n(\n  vector(-2)\n  and\n  (\n    sum(mms_queue_depth{carrier=\"unassigned\",status=~\"queued|sending|retry\"}) > 0\n  )\n  and\n  (\n    sum(\n      max by (carrier) (\n        mms_carrier_tps_capacity{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}\n      )\n      *\n      max by (carrier) (\n        mms_carrier_healthy{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}\n      )\n    ) <= 0\n  )\n)\nor\n(\n  vector(-1)\n  and\n  (\n    sum(mms_queue_depth{carrier=\"unassigned\",status=~\"queued|sending|retry\"}) > 0\n  )\n  and\n  (\n    sum(\n      max by (carrier) (\n        mms_carrier_tps_capacity{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}\n      )\n      *\n      max by (carrier) (\n        mms_carrier_healthy{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}\n      )\n    ) > 0\n  )\n  and\n  (\n    (\n      sum(rate(mms_messages_submitted_total[1m]))\n      -\n      sum(rate(mms_delivered_total{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}[1m]))\n    ) >= -5\n  )\n)\nor\n(\n  (\n    sum(mms_queue_depth{carrier=\"unassigned\",status=~\"queued|sending|retry\"})\n    /\n    clamp_min(\n      abs(\n        sum(rate(mms_messages_submitted_total[1m]))\n        -\n        sum(rate(mms_delivered_total{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}[1m]))\n      ),\n      0.001\n    )\n  )\n  and\n  (\n    sum(mms_queue_depth{carrier=\"unassigned\",status=~\"queued|sending|retry\"}) > 0\n  )\n  and\n  (\n    sum(\n      max by (carrier) (\n        mms_carrier_tps_capacity{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}\n      )\n      *\n      max by (carrier) (\n        mms_carrier_healthy{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}\n      )\n    ) > 0\n  )\n  and\n  (\n    (\n      sum(rate(mms_messages_submitted_total[1m]))\n      -\n      sum(rate(mms_delivered_total{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}[1m]))\n    ) < -5\n  )\n)",
