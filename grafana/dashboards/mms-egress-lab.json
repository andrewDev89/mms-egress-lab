                  "color": "dark-orange",
                  "index": 3,
                  "text": "Carrier capacity loss"
                },
                "4": {
                  "color": "red",
                  "index": 4,
                  "text": "Egress HTTP rejection pressure"
                },
                "5": {
                  "color": "dark-red",
                  "index": 5,
                  "text": "No healthy carrier capacity"
                },
                "6": {
                  "color": "dark-red",
                  "index": 6,
                  "text": "Mbuni unavailable"
                }
              },
              "type": "value"
            }
