          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "(vector(6) and (max(mbuni_up) == 0))\nor (vector(5) and (sum(max by (carrier) (mms_carrier_tps_capacity{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}) * max by (carrier) (mms_carrier_healthy{carrier=~\"tmobile-sdg1|tmobile-sdg2\"})) <= 0))\nor (vector(3) and (sum(max by (carrier) (mms_carrier_tps_capacity{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}) * max by (carrier) (mms_carrier_healthy{carrier=~\"tmobile-sdg1|tmobile-sdg2\"})) < sum(max by (carrier) (mms_carrier_tps_capacity{carrier=~\"tmobile-sdg1|tmobile-sdg2\"}))))\nor (vector(4) and (sum(rate(haproxy_frontend_http_responses_total{frontend=\"fe_http\",code=~\"4xx|5xx\"}[1m])) > 0))\nor (vector(0) and (sum(mms_queue_depth{carrier=\"unassigned\",status=~\"queued|sending|retry\"}) <= 0))\nor (vector(2) and ((sum(rate(mms_messages_submitted_total[1m])) - sum(rate(mbuni_mt_sent_total[1m]))) > 0))\nor (vector(1) and (sum(mms_queue_depth{carrier=\"unassigned\",status=~\"queued|sending|retry\"}) > 0) and ((sum(rate(mms_messages_submitted_total[1m])) - sum(rate(mbuni_mt_sent_total[1m]))) <= 0))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Egress Status",
      "type": "stat",
      "description": "Capacity loss is shown even with an empty queue. Actual rejection and retry rates are shown alongside it."
    },
